            //Mobile Nav
            var expendNav = document.querySelectorAll('body');
            var buttonArray = document.querySelectorAll('.mob-humburge-click');

            document.querySelectorAll('.mob-humburge-click').forEach(function (i) {
                i.addEventListener('click', function (e) {
                    const clickedBtnIndex = [...buttonArray].indexOf(e.target);
                    expendNav[clickedBtnIndex].classList.toggle("main-nav-show");
                })
            });
            //Mobile Nav body class remove
            var removeNav = document.querySelectorAll('body');
            var removebuttonArray = document.querySelectorAll('.fa-times');

            document.querySelectorAll('.mob-nav-head span').forEach(function (i) {
                i.addEventListener('click', function (e) {
                    const clickedBtnIndex1 = [...removebuttonArray].indexOf(e.target);
                    removeNav[clickedBtnIndex1].classList.remove("main-nav-show");
                })
            });

            //font increase decrease

            $(document).ready(function () {
                var y = 2;
                $("#ddmenu").removeClass("menuFontClass");
                $('body').delegate('.increase', 'click', function (e) {
                    $("#ddmenu").removeClass("menuFontClass");
                    $("#ddmenu").addClass("menuFontClass");

                    if (y < 4) {
                        $('*').each(function () {
                            var x = parseInt($(this).css("font-size"));
                            x = x + 1;
                            $(this).css("font-size", x);
                        });
                        y = y + 1;
                    }
                });
                $('body').delegate('.decrease', 'click', function (e) {
                    if (y > 0) {
                        $('*').each(function () {
                            var x = parseInt($(this).css("font-size"));
                            x = x - 1;
                            $(this).css("font-size", x);
                        });
                        y = y - 1;
                    }
                });
                $('body').delegate('.reset', 'click', function (e) {
                    $("#ddmenu").removeClass("menuFontClass");
                    $('*').each(function () {
                        $(this).css("font-size", "");
                    });
                    y = 2;
                });

                $("#ddmenu").click(function () {
                    $("#ddmenu").addClass("menuClass");
                });
            });
            //audio script
            function txtSpeak() {

                function voiceStartCallback() {
                    $('.btnListen').html('<strong class="fa fa-volume-up" ></strong>Stop');
                }

                function voiceEndCallback() {
                    $('.btnListen').html('<strong class="fa fa-volume-up" ></strong>Listen');
                }

                var parameters = {
                    rate: 1.1,
                    onstart: voiceStartCallback,
                    onend: voiceEndCallback
                }


                if (responsiveVoice.isPlaying()) {
                    responsiveVoice.cancel();
                    $('.btnListen').html('<strong class="fa fa-volume-up" ></strong>Listen');
                }
                else {
                    responsiveVoice.setDefaultVoice("US English Male");
                    $('.btnListen').html('<strong class="fa fa-volume-up" ></strong>Stop');
                    var txtforspeech = $(".main-detail").text().replace(/\s+/g, " ");
                    responsiveVoice.speak(txtforspeech, 'US English Male', parameters);
                }

            }
        </script>
        
        <script type="text/javascript">
            $(window).scroll(function () {
                if ($(window).scrollTop() > 10) {
                    $('#totop').stop(true, false).animate({ 'opacity': '1', 'right': '30' }, 500);
                } else {
                    $('#totop').stop(true, false).animate({ 'opacity': '0', 'right': '-60' }, 500);
                }
            });

            $('#totop').click(function () {
                $('html, body').animate({ scrollTop: 0 }, 800);
                return false;
            });
        </script>
		
