  <script>
      // var expandArray = document.querySelectorAll('body');
      // var buttonArray = document.querySelectorAll('.r-dropdown');

      // document.querySelectorAll('.r-dropdown').forEach(function(i) {
      //   i.addEventListener('click', function(e) {
      //     const clickedBtnIndex = [...buttonArray].indexOf(e.target);
      //     expandArray[clickedBtnIndex].classList.toggle("active-rpanel");
      //   })
      // });
      $(document).ready(function () {
          $('.owl-4bx-carousel').owlCarousel({
              loop: true,
              responsiveClass: true,
              autoplay: true,
              responsive: {
                  0: {
                      items: 1,
                      nav: true
                  },
                  600: {
                      items: 4,
                      nav: false
                  },
                  1000: {
                      items: 4,
                      nav: true,
                  }
              }
          })
          $('.owl-1bx-carousel').owlCarousel({
              loop: true,
              responsiveClass: true,
              autoplay: true,
              responsive: {
                  0: {
                      items: 1,
                      nav: true
                  },
                  600: {
                      items: 1,
                      nav: false
                  },
                  1000: {
                      items: 1,
                      nav: true,
                  }
              }
          })
      })

      /*fixed-header*/
      window.onscroll = function () { myFunction() };

      var header = document.getElementById("main-header");
      var sticky = header.offsetTop;

      function myFunction() {
          if (window.pageYOffset > sticky) {
              header.classList.add("sticky");
          } else {
              header.classList.remove("sticky");
          }
      }
      // ticker js
      jQuery(document).ready(function ($) {
          $('.my-news-ticker').AcmeTicker({
              type: 'typewriter',/*horizontal/horizontal/Marquee/type*/
              direction: 'right',/*up/down/left/right*/
              speed: 50,/*true/false/number*/ /*For vertical/horizontal 600*//*For marquee 0.05*//*For typewriter 50*/
              controls: {
                  prev: $('.acme-news-ticker-prev'),/*Can be used for horizontal/horizontal/typewriter*//*not work for marquee*/
                  toggle: $('.acme-news-ticker-pause'),/*Can be used for horizontal/horizontal/typewriter*//*not work for marquee*/
                  next: $('.acme-news-ticker-next')/*Can be used for horizontal/horizontal/marquee/typewriter*/
              }
          });

          $(".acme-news-ticker-pause").click(function () {
              $(this).toggleClass("acme-news-ticker-play");
          });


      });

      //mega menu hover
      var expandArray = document.querySelectorAll('body');
      var buttonArray = document.querySelectorAll('.active-cat-nav');

      document.querySelectorAll('.active-cat-nav').forEach(function (i) {
          i.addEventListener('click', function (e) {
              const clickedBtnIndex = [...buttonArray].indexOf(e.target);
              expandArray[clickedBtnIndex].classList.toggle('active-rpanel');
          })
      });
  </script>
        <script>
            //Second Level mega dropdown
            $(document).ready(function () {
                $(window).on("resize", function (e) {
                    checkScreenSize();
                });

                checkScreenSize();

                function checkScreenSize() {
                    var newWindowWidth = $(window).width();
                    if (newWindowWidth > 769) {

                        $(".tablinks").hover(function () {
                            var get_tab_id = $(this).attr('data-tab');
                            $('.tablinks').removeClass('tab_active');
                            $(this).addClass('tab_active');
                            $('.tab_cont_nav').hide();
                            $('#' + get_tab_id).show();
                        });
                        $(".corporatetablinks").hover(function () {
                            var get_tab_id_corpo = $(this).attr('data-tab');
                            $('.corporatetablinks').removeClass('corporate-active');
                            $(this).addClass('corporate-active');
                            $('.corporatetabcontent').hide();
                            $('#' + get_tab_id_corpo).show();
                        });
                        $(".customerCarelinks").hover(function () {
                            var get_tab_id_corpo = $(this).attr('data-tab');
                            $('.customerCarelinks').removeClass('customerCare-active');
                            $(this).addClass('customerCare-active');
                            $('.customerCarecontent').hide();
                            $('#' + get_tab_id_corpo).show();
                        });
                    }
                    else {
                        $(".tablinks").click(function () {
                            var get_tab_id = $(this).attr('data-tab');
                            $(this).parent().next('.tab_cont_nav').animate({ height: 'toggle' });
                            $('.tab_cont_nav').hide();
                            $('#' + get_tab_id).show();
                        });

                        $(".corpo-open-dropdown").click(function () {
                            $(this).next(".corporatetabcontent").animate({ height: 'toggle' });
                        });
                        $(".custo-open-dropdown").click(function () {
                            $(this).next(".customerCarecontent").animate({ height: 'toggle' });
                        });

                        $('.drodown-link').click(function () {
                            //$('.fullbox-menu').slideUp();
                            $(this).next(".fullbox-menu").animate({ height: 'toggle' });

                        });

                        $('.open-dropdown').click(function () {
                           $(this).next('ul').animate({ height: 'toggle' });
                       });
                       $('.open-dropdown').click(function () {
                           $(this).next('.tabcontent').animate({ height: 'toggle' });
                       });
					   $('.right-pannl-mob .ebanking-mob-click').click(function () {
                           $(this).next('ul').animate({ height: 'toggle' });
                       });
					   $('.search-mob .search-mob-click').click(function () {
                           $(this).next('ul').animate({ height: 'toggle' });
                       });
                    }
                }
            });

